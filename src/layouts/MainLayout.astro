---
import Metadata from '../components/Metadata.astro';
import Starfield from '../components/Starfield.astro';
interface Props {
  title: string;
}
const { title } = Astro.props;
const currentYear = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="en">
<head>
  <Metadata title={title} />
</head>
<body>
  <Starfield />
  
<nav class="site-nav">
  <div class="nav-container">
    <a href="/" class="nav-logo">NEBULINK</a>
    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/insights">Insights</a>
      <a href="#contact" class="nav-contact-btn">Contact</a>
    </div>
  </div>
</nav>

<slot />

  <footer class="global-footer">
    <div class="footer-container">
      <div class="footer-left">
        © {currentYear} NebuLink. All rights reserved. <span>//</span> Market intelligence for the space economy.
      </div>
      <div class="footer-right">
        <a href="https://www.linkedin.com/in/alistairschofield" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://alistairschofield.substack.com/" target="_blank" rel="noopener noreferrer">Substack</a>
      </div>
    </div>
  </footer>
</body>
</html>

<style is:global>
  /* 1. Global Core Variables Framework */
  :root {
    --bg:       #022B28;
    --bg2:      #011f1d;
    --bg3:      #033330;
    --surface:  #042f2c;
    --surface2: #053935;
    --gold:     #B8982A;
    --gold2:    #d4b445;
    --gold3:    rgba(184, 152, 42, 0.3);
    --text:     #e8e0cc;
    --muted:    #7a9490;
    --border:   rgba(184,152,42,0.15);
    --border2:  rgba(184,152,42,0.08);
  }

  /* 2. Global Document Reset Overrides */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Barlow', sans-serif;
    font-weight: 300;
    overflow-x: hidden;
    cursor: auto;
  }

  /* Premium Analogue Fine-Grain Overlay */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
    opacity: 0.4;
  }

  /* 3. Universal Layout Tracking Utility */
  .section-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 60px;
    box-sizing: border-box;
  }

  /* 4. Decentralized Component Global Utility Styles */
  .section-eyebrow-label {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 24px;
    display: block;
    width: 100%;
    text-align: center;
  }

  /* 5. Centralized Fixed Header Styling */
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    background: rgba(2, 43, 40, 0.75);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 60px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .nav-logo {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: #fff;
    text-decoration: none;
  }
/* Make sure your existing .nav-links aligns the new button vertically */
/* Update your links wrapper to ensure flawless flex alignment */
.nav-links {
  display: flex;
  align-items: center; /* Forces total vertical centering on the cross-axis */
  gap: 24px; 
}

/* Updated Contact Link styling to match flawlessly */
.nav-links .nav-contact-btn {
  color: var(--gold) !important;
  
  /* 1. FONT MATCH FIX: Inherit the exact font family your nav uses */
  font-family: inherit; 
  font-size: 0.8rem; /* Check if your main links are 0.75rem or 0.8rem, match it here */
  font-weight: 500;
  letter-spacing: 0.08em; /* Slightly tighter tracking to match HOME/INSIGHTS */
  text-transform: uppercase;
  text-decoration: none;
  
  /* 2. ALIGNMENT FIX: Use box-sizing and balance padding so the baseline locks in */
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  padding: 4px 0; 
  margin-left: 8px;
  
  /* Keep the elegant line reveal */
  border-bottom: 1px solid transparent;
  transition: border-color 0.25s ease;
}

/* Handles the clean underline effect while keeping it gold */
.nav-links .nav-contact-btn:hover {
  border-bottom: 1px solid var(--gold);

}
  .nav-links a {
    font-family: 'Barlow', sans-serif;
    font-size: 0.85rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .nav-links a:hover {
    color: var(--gold);
  }

  /* 6. Production-Ready Global Footer Layout */
  .global-footer {
    width: 100%;
    border-top: 1px solid var(--border2);
    padding: 60px 0 40px 0;
    margin-top: 80px;
  }
  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 60px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .footer-container span { color: var(--gold3); margin: 0 4px; }
  .footer-container a { color: var(--muted); text-decoration: none; margin-left: 24px; transition: color 0.2s ease; }
  .footer-container a:hover { color: var(--gold); }

  /* 7. Unified Core Breakpoints */
  @media (max-width: 768px) {
    .section-container { padding: 0 24px; }
    .nav-container { padding: 20px 24px; }
    .footer-container { padding: 0 24px; }
  }

  @media (max-width: 600px) {
    .footer-container { flex-direction: column; gap: 20px; text-align: center; }
    .footer-container a { margin: 0 12px; }
  }
</style>