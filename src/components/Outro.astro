---
// NebuLink Outro & Intake Portal Component
const currentYear = new Date().getFullYear();
---
<section class="outro-section" id="contact">
  <div class="section-container">
    
    <div class="section-eyebrow-label">03. Contact</div>
    
    <div class="outro-split-grid">
      
      <div class="outro-header-panel">
        <h2 class="outro-title">Get in Touch</h2>
        <p class="outro-subtitle">
          Whether you are looking for specific market intelligence, have questions about our analysis, or want to discuss a custom project, send over a message. 
        </p>
      </div>

      <div class="intake-box">
        <form class="intake-form" onsubmit="event.preventDefault(); alert('Message successfully sent.');">
          <div class="form-row">
            <input type="email" placeholder="Email Address" required />
            <input type="text" placeholder="Organisation / Company" required />
          </div>
          <div class="form-row full-width">
            <textarea placeholder="How can we help you? Describe your inquiry or project requirements..." rows="3" required></textarea>
          </div>
          
          <button type="submit" class="submit-btn">Send Message ↗</button>
        </form>
      </div>

    </div>

    <footer>
      <div class="footer-left">
        © {currentYear} NebuLink. All rights reserved. <span>//</span> Market intelligence for the space economy.
      </div>
      <div class="footer-right">
        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://substack.com" target="_blank" rel="noopener noreferrer">Substack</a>
      </div>
    </footer>

  </div>
</section>

<style>
  .outro-section { 
    position: relative; 
    z-index: 2; 
    padding: 140px 0 40px 0;
    background: linear-gradient(180deg, var(--bg2) 0%, var(--bg) 100%);
  }

  .section-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .section-eyebrow-label {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 32px;
  }

  .outro-split-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: flex-start;
    margin-bottom: 100px;
  }
  
  .outro-header-panel {
    display: flex;
    flex-direction: column;
    text-align: left;
  }
  
  .outro-title { 
    font-family: 'Cormorant Garamond', serif; 
    font-size: clamp(2.5rem, 4vw, 3.8rem); 
    font-weight: 300; 
    line-height: 1.1; 
    color: var(--text); 
    margin-bottom: 24px; 
  }
  .outro-subtitle { font-size: 0.95rem; line-height: 1.8; color: var(--muted); max-width: 460px; }

  .intake-box { 
    position: relative;
    width: 100%;
  }

  .intake-form { display: flex; flex-direction: column; gap: 32px; }
  
  /* Input layouts */
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .form-row.full-width { grid-template-columns: 1fr; }
  
  /* Minimalist structural styling */
  .intake-form input, .intake-form textarea { 
    background: transparent; 
    border: none;
    border-bottom: 1px solid var(--border2); 
    padding: 12px 0; 
    color: var(--text); 
    font-family: 'Barlow', sans-serif; 
    font-size: 0.9rem; 
    transition: border-color 0.4s ease;
    width: 100%;
    border-radius: 0;
  }
  
  .intake-form textarea {
    resize: none;
  }

  .intake-form input:focus, .intake-form textarea:focus { 
    outline: none; 
    border-color: var(--gold3); 
  }
  
  .intake-form input::placeholder, .intake-form textarea::placeholder {
    color: rgba(255, 255, 255, 0.3);
    font-weight: 300;
  }
  
  .submit-btn { 
    align-self: flex-start; 
    background: transparent; 
    border: 1px solid var(--gold3); 
    color: var(--gold); 
    font-family: 'Barlow Condensed', sans-serif; 
    font-size: 0.8rem; 
    font-weight: 600; 
    letter-spacing: 0.15em; 
    text-transform: uppercase; 
    padding: 16px 40px; 
    cursor: pointer; 
    transition: all 0.3s ease; 
    margin-top: 12px;
  }
  .submit-btn:hover { background: var(--gold); color: var(--bg); border-color: var(--gold); }

  footer { 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    border-top: 1px solid var(--border2); 
    padding-top: 40px; 
    font-family: 'Barlow Condensed', sans-serif; 
    font-size: 0.75rem; 
    letter-spacing: 0.08em; 
    color: var(--muted); 
  }
  footer span { color: var(--gold3); margin: 0 4px; }
  footer a { color: var(--muted); text-decoration: none; margin-left: 24px; transition: color 0.2s; }
  footer a:hover { color: var(--gold); }

  @media (max-width: 968px) {
    .outro-split-grid { grid-template-columns: 1fr; gap: 56px; margin-bottom: 60px; }