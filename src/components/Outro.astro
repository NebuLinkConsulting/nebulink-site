---
// NebuLink Outro & Intake Portal Component
const currentYear = new Date().getFullYear();
---
<section class="outro-section" id="contact">
  <div class="container">
    
    <div class="intake-box">
      <div class="eyebrow">
        <div class="eyebrow-line"></div>
        <span>Secure Engagement</span>
      </div>
      
      <h2 class="outro-title">Engage <span>NebuLink</span></h2>
      <p class="outro-subtitle">
        Whether you require bespoke downstream data integration models, technical due diligence on satellite infrastructure, or priority access to upcoming market intelligence reports, contact us to schedule an initial briefing.
      </p>

      <form class="intake-form" onsubmit="event.preventDefault(); alert('Message successfully transmitted.');">
        <div class="form-row">
          <input type="text" placeholder="Full Name" required />
          <input type="email" placeholder="Institutional Email" required />
        </div>
        <div class="form-row">
          <input type="text" placeholder="Organisation" required />
          <input type="text" placeholder="Area of Inquiry (e.g., Data Relays, Consultancy)" required />
        </div>
        <textarea placeholder="Briefly outline your project requirements or strategic objectives..." rows="5" required></textarea>
        
        <button type="submit" class="submit-btn">Initiate Briefing ↗</button>
      </form>
    </div>

    <footer>
      <div class="footer-left">
        © {currentYear} NebuLink. All rights reserved. <span>//</span> Strategic clarity for the space economy.
      </div>
      <div class="footer-right">
        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://substack.com" target="_blank" rel="noopener noreferrer">Substack</a>
      </div>
    </footer>

  </div>
</section>

<style>
  .outro-section { 
    position: relative; 
    z-index: 2; 
    padding: 120px 60px 40px; 
    background: linear-gradient(180deg, var(--bg2) 0%, var(--bg) 100%);
  }
  .container { max-width: 1200px; margin: 0 auto; }
  
  .intake-box { 
    max-width: 800px; 
    margin: 0 auto 100px; 
    background: var(--surface); 
    border: 1px solid var(--border2); 
    padding: 60px; 
    position: relative;
  }
  .intake-box::after { 
    content: ''; 
    position: absolute; 
    inset: 0; 
    border: 1px solid rgba(184,152,42,0.05); 
    margin: 8px; 
    pointer-events: none; 
  }

  .eyebrow { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
  .eyebrow-line { width: 24px; height: 1px; background: var(--gold); }
  .eyebrow span { font-family: 'Barlow Condensed', sans-serif; font-size: 0.7rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--gold); }
  
  .outro-title { font-family: 'Cormorant Garamond', serif; font-size: clamp(2.5rem, 4vw, 3.8rem); font-weight: 300; line-height: 1.1; color: var(--text); margin-bottom: 20px; }
  .outro-title span { font-style: italic; color: var(--gold); font-weight: 400; }
  .outro-subtitle { font-size: 0.9rem; line-height: 1.8; color: var(--muted); margin-bottom: 40px; max-width: 650px; }

  /* Interactive Form Architecture */
  .intake-form { display: flex; flex-direction: column; gap: 20px; position: relative; z-index: 3; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  
  .intake-form input, .intake-form textarea { 
    background: var(--bg2); 
    border: 1px solid var(--border2); 
    padding: 16px; 
    color: var(--text); 
    font-family: 'Barlow', sans-serif; 
    font-size: 0.88rem; 
    transition: border-color 0.3s;
  }
  .intake-form input:focus, .intake-form textarea:focus { 
    outline: none; 
    border-color: var(--gold3); 
  }
  
  .submit-btn { 
    align-self: flex-start; 
    background: transparent; 
    border: 1px solid var(--gold3); 
    color: var(--gold); 
    font-family: 'Barlow Condensed', sans-serif; 
    font-size: 0.8rem; 
    font-weight: 600; 
    letter-spacing: 0.15em; 
    text-transform: uppercase; 
    padding: 16px 36px; 
    cursor: pointer; 
    transition: all 0.3s; 
  }
  .submit-btn:hover { background: var(--gold); color: var(--bg); border-color: var(--gold); }

  /* Clean Utilities Footer */
  footer { 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    border-top: 1px solid var(--border2); 
    padding-top: 40px; 
    font-family: 'Barlow Condensed', sans-serif; 
    font-size: 0.75rem; 
    letter-spacing: 0.08em; 
    color: var(--muted); 
  }
  footer span { color: var(--gold3); margin: 0 4px; }
  footer a { color: var(--muted); text-decoration: none; margin-left: 24px; transition: color 0.2s; }
  footer a:hover { color: var(--gold); }

  @media (max-width: 768px) {
    .intake-box { padding: 32px; margin-bottom: 60px; }
    .form-row { grid-template-columns: 1fr; gap: 20px; }
    footer { flex-direction: column; gap: 20px; text-align: center; }
    footer a { margin: 0 12px; }
  }
</style>