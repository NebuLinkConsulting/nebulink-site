---
// ReportSpotlight.astro - Top-level Intelligence Asset Showcase
---
<section class="spotlight-section" id="reports">
  <div class="section-container">
    
    <div class="section-eyebrow-label">01. Published Intelligence</div>

    <div class="spotlight-container">
      
      <div class="report-preview-side">
        <div class="report-card-mockup">
          <div class="report-tag">Upcoming Intelligence</div>
          <div class="report-meta">Market Report • Q3 2026</div>
          <h3 class="report-mock-title">Analysis of the Space Data Relay Market</h3>
          <p class="report-mock-subtitle">Global Architecture, Infrastructure Mapping & Commercial Ecosystem Dynamics</p>
          <div class="report-mock-logo">NEBULINK</div>
        </div>
      </div>

      <div class="report-details-side">
        <h2 class="section-title">The Space Data Relay Market</h2>
        
        <p class="section-desc">
          As low-Earth orbit constellations scale exponentially, traditional ground station networks face critical latency bottlenecks. This comprehensive technical and commercial report maps the emerging space-to-space data relay architecture, profiling key operators, optical inter-satellite link (OISL) adoption, and sovereign data relay infrastructure.
        </p>

        <div class="key-pillars">
          <div class="pillar">
            <strong>Ecosystem Mapping</strong>
            <p>Granular profiles of commercial and institutional relay network architectures.</p>
          </div>
          <div class="pillar">
            <strong>Spectrum & Dynamics</strong>
            <p>Analysis of RF constraints and the transition to high-throughput laser communication.</p>
          </div>
        </div>

        <div class="access-box">
          <h4>Request Executive Summary & Launch Updates</h4>
          <form class="access-form" id="spotlight-inquiry-form">
            <input type="hidden" name="org" value="Spotlight Report Request" />
            <input type="hidden" name="message" value="User requested the Executive Summary & Launch Updates for the Space Data Relay Market Report." />
            
            <input type="email" name="email" placeholder="Institutional email address" required />
            <button type="submit">Inquire for Access ↗</button>
          </form>
          <div id="form-status" class="status-msg"></div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('spotlight-inquiry-form') as HTMLFormElement;
  const statusEl = document.getElementById('form-status');

  if (form && statusEl) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      statusEl.textContent = 'Sending request...';
      statusEl.className = 'status-msg processing';

      const formData = new FormData(form);

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          body: formData
        });

        const result = await response.json();

        if (response.ok && result.success) {
          statusEl.textContent = 'Request received successfully. We will follow up shortly.';
          statusEl.className = 'status-msg success';
          form.reset();
        } else {
          statusEl.textContent = result.error || 'Failed to submit request. Please try again.';
          statusEl.className = 'status-msg error';
        }
      } catch (error) {
        console.error('Submission error:', error);
        statusEl.textContent = 'A network error occurred. Please try again.';
        statusEl.className = 'status-msg error';
      }
    });
  }
</script>

<style>
  .spotlight-section { 
    position: relative; 
    z-index: 2; 
    padding: 140px 0; 
    background: linear-gradient(180deg, var(--bg) 0%, var(--bg2) 100%); 
    border-bottom: 1px solid var(--border2); 
  }  
  
  .spotlight-container { 
    display: grid; 
    grid-template-columns: 1fr 1.2fr; 
    gap: 80px; 
    align-items: center;
    margin-top: 32px; 
  }
  
  .report-preview-side { 
    display: flex; 
    justify-content: center; 
  }
  
  .report-card-mockup { 
    width: 100%; 
    max-width: 380px; 
    aspect-ratio: 1 / 1.4; 
    background: linear-gradient(145deg, #043632 0%, var(--bg3) 100%); 
    border: 1px solid var(--gold); 
    padding: 40px; 
    display: flex; 
    flex-direction: column; 
    justify-content: space-between; 
    position: relative; 
    box-shadow: 0 30px 60px rgba(0,0,0,0.4); 
  }
  .report-card-mockup::after { 
    content: ''; 
    position: absolute; 
    inset: 0; 
    border: 1px solid rgba(184,152,42,0.2); 
    margin: 6px; 
    pointer-events: none; 
  }
  
  .report-tag { 
    align-self: flex-start; 
    font-family: 'Barlow Condensed', sans-serif; 
    font-size: 0.65rem; 
    font-weight: 600; 
    letter-spacing: 0.2em; 
    text-transform: uppercase; 
    color: var(--gold); 
    border: 1px solid var(--gold3); 
    padding: 4px 10px; 
  }
  .report-meta { 
    font-family: 'Barlow Condensed', sans-serif; 
    font-size: 0.75rem; 
    letter-spacing: 0.15em; 
    text-transform: uppercase; 
    color: var(--muted); 
    margin-top: auto; 
  }
  .report-mock-title { 
    font-family: 'Cormorant Garamond', serif; 
    font-size: 2.2rem; 
    font-weight: 400; 
    line-height: 1.1; 
    color: var(--text); 
    margin: 12px 0 8px; 
  }
  .report-mock-subtitle { 
    font-size: 0.75rem; 
    line-height: 1.6; 
    color: var(--muted); 
    margin-bottom: auto; 
  }
  .report-mock-logo { 
    font-family: 'Barlow Condensed', sans-serif; 
    font-weight: 700; 
    font-size: 0.9rem; 
    letter-spacing: 0.3em; 
    color: var(--gold3); 
  }
  
  .section-title { 
    font-family: 'Cormorant Garamond', serif; 
    font-size: clamp(2rem, 3.5vw, 3.2rem); 
    font-weight: 300; 
    line-height: 1.1; 
    color: var(--text); 
    margin-bottom: 24px; 
  }
  .section-desc { 
    font-size: 0.88rem; 
    line-height: 1.85; 
    color: var(--muted); 
    margin-bottom: 36px; 
  }
  
  .key-pillars { 
    display: flex; 
    gap: 32px; 
    margin-bottom: 40px; 
    border-top: 1px solid var(--border2); 
    padding-top: 30px; 
  }
  .pillar { flex: 1; }
  .pillar strong { 
    font-family: 'Barlow Condensed', sans-serif; 
    font-size: 0.85rem; 
    letter-spacing: 0.1em; 
    text-transform: uppercase; 
    color: var(--text); 
    display: block; 
    margin-bottom: 8px; 
  }
  .pillar p { 
    font-size: 0.8rem; 
    line-height: 1.6; 
    color: var(--muted); 
  }
  
  .access-box { 
    background: var(--surface); 
    border: 1px solid var(--border2); 
    padding: 24px; 
    margin-top: 20px;
  }
  .access-box h4 { 
    font-family: 'Barlow Condensed', sans-serif; 
    font-size: 0.75rem; 
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
    margin-bottom: 16px;
  }

  .access-form {
    display: flex;
    gap: 16px;
  }

  .access-form input {
    flex: 1;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border2);
    padding: 12px 0;
    color: var(--text);
    font-family: 'Barlow', sans-serif;
    font-size: 0.9rem;
    border-radius: 0;
    transition: border-color 0.4s ease;
  }

  .access-form input:focus {
    outline: none;
    border-color: var(--gold3);
  }

  .access-form input::placeholder {
    color: rgba(255, 255, 255, 0.3);
  }

  .access-form button {
    background: transparent;
    border: 1px solid var(--gold3);
    color: var(--gold);
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 12px 28px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .access-form button:hover {
    background: var(--gold);
    color: var(--bg);
    border-color: var(--gold);
  }

  .status-msg {
    margin-top: 12px;
    font-size: 0.8rem;
    font-family: 'Barlow', sans-serif;
  }
  .status-msg.success { color: #4ade80; }
  .status-msg.error { color: #f87171; }
  .status-msg.processing { color: var(--muted); }

  /* ================================================== */
  /* RESPONSIVE MOBILE FIX: DESTRUCTS THE LAYOUT GRID  */
  /* ================================================== */
  @media (max-width: 768px) {
    .spotlight-section {
      padding: 60px 0 !important;
    }

    /* Clear the split columns entirely to fix text drift */
    .spotlight-container {
      display: block !important; 
      width: 100% !important;
      box-sizing: border-box !important;
    }

    .report-preview-side {
      width: 100% !important;
      display: block !important;
      margin-bottom: 40px !important;
    }

    .report-card-mockup {
      max-width: 100% !important;
      box-sizing: border-box !important;
      padding: 32px 24px !important;
    }

    /* Snap description text wrapper back to flush left padding boundary */
    .report-details-side {
      width: 100% !important;
      max-width: 100% !important;
      display: block !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    .key-pillars {
      flex-direction: column !important;
      gap: 20px !important;
      padding-top: 20px !important;
    }

    .access-box {
      padding: 16px !important;
      box-sizing: border-box !important;
    }

    .access-form {
      display: flex !important;
      flex-direction: column !important;
      gap: 16px !important;
      width: 100% !important;
    }

    .access-form input,
    .access-form button {
      width: 100% !important;
      box-sizing: border-box !important;
    }
  }
</style>