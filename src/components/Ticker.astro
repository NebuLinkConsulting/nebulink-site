<div class="ticker-section">
  <div class="ticker-track">
    {Array(2).fill([
      "Launch Market Analysis", "LEO Constellation Strategy", 
      "Earth Observation Markets", "Space Investment Intelligence", 
      "Policy & Regulatory Advisory", "M&A Due Diligence"
    ]).flat().map((item) => (
      <div class="ticker-item">
        <div class="ticker-sep"></div> 
        {item} {item.includes('Strategy') || item.includes('Intelligence') || item.includes('Diligence') ? <span>↗</span> : ''}
      </div>
    ))}
  </div>
</div>

<style>
  .ticker-section { 
    position: relative; 
    z-index: 2; 
    padding: 18px 0; 
    background: var(--bg2); 
    border-top: 1px solid var(--border); 
    border-bottom: 1px solid var(--border); 
    overflow: hidden; 
    width: 100%; /* Explicitly forces the outer container to use full-viewport width */
    display: flex;
    align-items: center;
  }
  
  .ticker-track { 
    display: flex; 
    width: max-content; 
    flex-shrink: 0;
    will-change: transform; /* Triggers GPU layer for seamless, micro-stutter-free motion */
    animation: ticker-scroll 35s linear infinite; 
  }
  
  .ticker-item { 
    display: flex; 
    align-items: center; 
    gap: 20px; 
    white-space: nowrap; 
    font-family: 'Barlow Condensed', sans-serif; 
    font-size: 0.7rem; 
    letter-spacing: 0.22em; 
    text-transform: uppercase; 
    color: var(--muted); 
    padding: 0 40px; 
    flex-shrink: 0;
  }
  
  .ticker-item span { color: var(--gold); }
  
  .ticker-sep { 
    width: 4px; 
    height: 4px; 
    background: var(--gold3); 
    transform: rotate(45deg); 
    flex-shrink: 0;
  }

  /* Keyframe tracking fix: moving exactly half of the double-cloned track array width */
  @keyframes ticker-scroll { 
    0% { transform: translate3d(0, 0, 0); } 
    100% { transform: translate3d(-50%, 0, 0); } 
  }
  
  /* Pause marquee action if user hovers—classic high-end dashboard detail */
  .ticker-section:hover .ticker-track {
    animation-play-state: paused;
  }
</style>