---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const allBriefings = await getCollection('insights');

const sortedBriefings = allBriefings.sort((a: CollectionEntry<'insights'>, b: CollectionEntry<'insights'>) => {
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

const cleanTitle = (title: string) => title.replace(/^\d+\s*\.\s*/, '').trim();
const formatDate = (dateStr: string) => {
  const d = new Date(dateStr);
  return isNaN(d.getTime()) ? dateStr : d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
};
---

<section class="insights-section">
  <div class="section-container insights-layout">
    
    <div class="insights-header-panel">
      <div class="section-eyebrow-label">02. Insights</div>
    </div>

    <div class="insights-scroll-container">
      <div class="insights-track">
        {sortedBriefings.map((brief: CollectionEntry<'insights'>) => (
          <article class="briefing-card">
            <div class="card-content">
              <div class="card-meta">
                <time class="card-date">{formatDate(brief.data.date)}</time>
                <span class="card-tag">{brief.data.tag || 'Space Intelligence'}</span>
              </div>
              
              <h3 class="card-title">{cleanTitle(brief.data.title)}</h3>
              <p class="card-excerpt">{brief.data.excerpt || brief.data.description}</p>
            </div>
            
            <a href={`/insights/${brief.id}`} class="card-link">
              Read Full Briefing <span class="arrow">↗</span>
            </a>
          </article>
        ))}
      </div>
    </div>

    <div class="insights-footer-panel">
      <a href="/insights" class="instant-vault-link">
        View All Briefings <span class="link-arrow">→</span>
      </a>
    </div>

  </div>
</section>

<style>
  .insights-section {
    padding: 140px 0;
    background: #022B28; 
    position: relative;
    z-index: 2;
    width: 100%;
    overflow: hidden; 
  }

  .insights-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .insights-header-panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    max-width: 1200px;
    padding: 0 24px;
    text-align: left;
    margin-bottom: 24px; /* Explicit, tight gap below header */
  }

  /* Viewport window container parameters */
  .insights-scroll-container {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    white-space: nowrap; 
    scrollbar-width: none; 
    -ms-overflow-style: none;
    padding: 0; /* Stripped default vertical padding */
    margin-bottom: 32px; /* Controlled gap below the track */
  }
  
  .insights-scroll-container::-webkit-scrollbar {
    display: none; 
  }

  .insights-track {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap; 
    gap: 32px;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    width: max-content; 
    padding-left: max(24px, calc((100vw - 1200px) / 2)); 
    padding-right: max(24px, calc((100vw - 1200px) / 2));
  }
  
  .briefing-card {
    flex: 0 0 440px; 
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--surface); 
    border: 1px solid var(--border2); 
    padding: 40px;
    scroll-snap-align: start; 
    transition: border-color 0.3s ease;
    white-space: normal; 
  }

  .briefing-card:hover {
    border-color: var(--gold3);
  }

  .card-content {
    margin-bottom: 32px;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .card-date { color: #66827e; }
  
  .card-tag {
    color: var(--gold);
    font-size: 0.7rem;
    border: 1px solid rgba(184, 152, 42, 0.2);
    padding: 2px 8px;
    text-transform: uppercase;
  }

  .card-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.3;
    color: var(--text);
    margin-bottom: 16px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 4.5rem; 
  }

  .card-excerpt {
    font-size: 0.88rem;
    line-height: 1.7;
    color: #cbd5e1;
    display: -webkit-box;
    -webkit-line-clamp: 3; 
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-link {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-start; 
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: border-color 0.2s;
  }

  .briefing-card:hover .card-link {
    border-color: var(--gold);
  }

  .arrow { font-size: 0.75rem; }

  /* Centered link layout container at the bottom */
  .insights-footer-panel {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  /* Clean, Institutional Sub-Link for Fast Exit */
  .instant-vault-link {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    opacity: 0.8;
    transition: all 0.2s ease;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
  }

  .instant-vault-link:hover {
    opacity: 1;
    border-color: var(--gold3);
  }

  .link-arrow {
    transition: transform 0.2s ease;
  }

  .instant-vault-link:hover .link-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 600px) {
    .briefing-card {
      flex: 0 0 calc(100vw - 48px); 
    }
  }
</style>

<script>
  const scrollContainer = document.querySelector('.insights-scroll-container');

  if (scrollContainer) {
    scrollContainer.addEventListener('wheel', (evt) => {
      if (evt.deltaY !== 0) {
        evt.preventDefault();
        scrollContainer.scrollLeft += evt.deltaY;
      }
    }, { passive: false });
  }
</script>